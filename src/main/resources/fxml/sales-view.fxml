<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.SaleController">
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-area" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="10.0" styleClass="content-area">
               <padding>
                  <Insets bottom="24.0" left="32.0" right="32.0" top="32.0" />
               </padding>
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="page-title" text="Vendas" />
                        <Label styleClass="page-subtitle" text="Monte o carrinho, escolha o pagamento e finalize a venda." />
                     </children>
                  </VBox>

                  <VBox spacing="14.0" styleClass="dashboard-panel">
                     <children>
                        <Label styleClass="sale-step-title" text="1. Inserir itens" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Cliente (opcional)" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <TextField fx:id="selectedCustomerField" prefHeight="42.0" promptText="Buscar por nome ou CPF/CNPJ..." HBox.hgrow="ALWAYS" />
                                          <Button mnemonicParsing="false" onAction="#handleSearchCustomer" prefHeight="42.0" prefWidth="88.0" styleClass="secondary-button" text="Buscar" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="field-label" text="Produto" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <TextField fx:id="selectedProductField" prefHeight="42.0" promptText="Buscar por nome ou código..." HBox.hgrow="ALWAYS" />
                                          <Button mnemonicParsing="false" onAction="#handleSearchProduct" prefHeight="42.0" prefWidth="88.0" styleClass="secondary-button" text="Buscar" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label styleClass="field-label" text="Qtd." />
                                    <TextField fx:id="quantityField" prefHeight="42.0" prefWidth="92.0" promptText="1" />
                                 </children>
                              </VBox>
                              <Button fx:id="addItemButton" mnemonicParsing="false" onAction="#handleAddItem" prefHeight="42.0" prefWidth="150.0" styleClass="primary-button" text="Adicionar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <VBox spacing="14.0" styleClass="dashboard-panel" VBox.vgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="sale-step-title" text="2. Carrinho" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="removeItemButton" mnemonicParsing="false" onAction="#handleRemoveItem" prefHeight="38.0" prefWidth="130.0" styleClass="secondary-button" text="Remover item" />
                           </children>
                        </HBox>
                        <TableView fx:id="cartTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="productColumn" prefWidth="500.0" styleClass="left-aligned-column" text="Produto" />
                              <TableColumn fx:id="quantityColumn" prefWidth="90.0" text="Qtd." />
                              <TableColumn fx:id="unitPriceColumn" prefWidth="180.0" text="Preço" />
                              <TableColumn fx:id="subtotalColumn" prefWidth="180.0" text="Subtotal" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>

                  <VBox spacing="12.0" styleClass="dashboard-panel">
                     <children>
                        <Label styleClass="sale-step-title" text="3. Pagamento e finalização" />
                        <HBox alignment="CENTER_LEFT" spacing="18.0">
                           <children>
                              <VBox spacing="10.0">
                                 <children>
                                    <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                       <children>
                                          <VBox spacing="6.0">
                                             <children>
                                                <Label styleClass="field-label" text="Desconto (R$)" />
                                                <TextField fx:id="discountField" prefHeight="42.0" prefWidth="150.0" promptText="0,00" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="6.0">
                                             <children>
                                                <Label styleClass="field-label" text="Forma de pagamento" />
                                                <ChoiceBox fx:id="paymentMethodChoiceBox" prefHeight="42.0" prefWidth="210.0" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                       <children>
                                          <VBox fx:id="installmentsGroup" managed="false" spacing="6.0" visible="false">
                                             <children>
                                                <Label styleClass="field-label" text="Parcelas" />
                                                <ChoiceBox fx:id="installmentsChoiceBox" prefHeight="42.0" prefWidth="120.0" visible="false" managed="false" />
                                             </children>
                                          </VBox>
                                          <VBox fx:id="firstDueDateGroup" managed="false" spacing="6.0" visible="false">
                                             <children>
                                                <Label styleClass="field-label" text="Primeiro vencimento" />
                                                <DatePicker fx:id="firstDueDatePicker" prefHeight="42.0" prefWidth="190.0" promptText="Data" visible="false" managed="false" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <Label fx:id="messageLabel" styleClass="text-muted-left" text="" wrapText="true" />
                                 </children>
                              </VBox>
                              <Region HBox.hgrow="ALWAYS" />
                              <VBox alignment="CENTER_RIGHT" minWidth="300.0" prefWidth="320.0" spacing="4.0">
                                 <children>
                                    <HBox alignment="CENTER_RIGHT" minWidth="300.0" prefWidth="320.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="sale-total-caption" text="Subtotal" />
                                          <Label fx:id="subtotalValueLabel" minWidth="130.0" styleClass="sale-subtotal-value" text="R$ 0,00" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_RIGHT" minWidth="300.0" prefWidth="320.0" spacing="12.0">
                                       <children>
                                          <Label styleClass="sale-total-label" text="TOTAL:" />
                                          <Label fx:id="totalValueLabel" minWidth="170.0" styleClass="sale-total-value" text="R$ 0,00" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                              <Button fx:id="finishSaleButton" mnemonicParsing="false" onAction="#handleFinishSale" prefHeight="54.0" prefWidth="210.0" styleClass="primary-button" text="Finalizar venda" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
