<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="contentArea" spacing="24.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.DashboardController">
   <padding>
      <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
   </padding>
   <children>
      <VBox>
         <children>
            <Label styleClass="page-title" text="Dashboard" />
            <Label styleClass="page-subtitle" text="Visão geral do seu negócio hoje." />
         </children>
      </VBox>
      <HBox spacing="20.0">
         <children>
            <VBox prefHeight="140.0" prefWidth="220.0" styleClass="dashboard-card">
               <children>
                  <Label styleClass="card-label" text="Vendas hoje" />
                  <Label fx:id="salesTodayValueLabel" styleClass="card-value" text="R$ 0,00" />
                  <Label fx:id="salesTodayFootnoteLabel" styleClass="card-footnote" text="Nenhuma venda registrada" />
               </children>
            </VBox>
            <VBox prefHeight="140.0" prefWidth="220.0" styleClass="dashboard-card">
               <children>
                  <Label styleClass="card-label" text="Clientes" />
                  <Label fx:id="customersValueLabel" styleClass="card-value" text="0" />
                  <Label fx:id="customersFootnoteLabel" styleClass="card-footnote-success" text="Comece cadastrando clientes" />
               </children>
            </VBox>
            <VBox prefHeight="140.0" prefWidth="220.0" styleClass="dashboard-card">
               <children>
                  <Label styleClass="card-label" text="Produtos" />
                  <Label fx:id="productsValueLabel" styleClass="card-value" text="0" />
                  <Label fx:id="productsFootnoteLabel" styleClass="card-footnote-warning" text="Estoque ainda vazio" />
               </children>
            </VBox>
            <VBox prefHeight="140.0" prefWidth="160.0" styleClass="dashboard-card">
               <children>
                  <Label styleClass="card-label" text="Saldo" />
                  <Label fx:id="balanceValueLabel" styleClass="card-value" text="R$ 0" />
                  <Label styleClass="card-footnote" text="Inicial" />
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox spacing="18.0">
         <children>
            <VBox fx:id="shortcutsPanel" prefWidth="880.0" styleClass="dashboard-panel">
               <children>
                  <Label styleClass="panel-title" text="Atalhos" />
                  <HBox spacing="16.0">
                     <children>
                        <Button fx:id="newSaleButton" mnemonicParsing="false" onAction="#handleSales" prefHeight="44.0" prefWidth="190.0" styleClass="primary-button" text="Nova venda" />
                        <Button fx:id="newCustomerButton" mnemonicParsing="false" onAction="#handleCustomers" prefHeight="44.0" prefWidth="190.0" styleClass="secondary-button" text="Cadastrar cliente" />
                        <Button fx:id="newProductButton" mnemonicParsing="false" onAction="#handleProducts" prefHeight="44.0" prefWidth="190.0" styleClass="secondary-button" text="Cadastrar produto" />
                        <Button fx:id="viewStockButton" mnemonicParsing="false" onAction="#handleStock" prefHeight="44.0" prefWidth="190.0" styleClass="secondary-button" text="Ver estoque" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox fx:id="alertsPanel" prefWidth="880.0" spacing="18.0" styleClass="dashboard-panel">
               <children>
                  <Label styleClass="panel-title" text="Alertas" />
                  <HBox fx:id="alertsList" spacing="14.0">
                     <children>
                        <Label fx:id="emptyAlertsLabel" prefWidth="820.0" styleClass="text-muted-left" text="Nenhum alerta por enquanto." wrapText="true" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>
