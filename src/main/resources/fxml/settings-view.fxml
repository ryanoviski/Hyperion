<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.SettingsController">
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-area" BorderPane.alignment="CENTER">
         <content>
            <VBox maxWidth="1.7976931348623157E308" spacing="22.0">
               <padding>
                  <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
               </padding>
               <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="page-title" text="Configurações" />
                  <Label styleClass="page-subtitle" text="Gerencie segurança, dados locais e informações do Hyperion." />
               </children>
            </VBox>
            <HBox spacing="20.0">
               <children>
                  <VBox maxWidth="1.7976931348623157E308" prefWidth="430.0" spacing="14.0" styleClass="dashboard-panel" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="panel-title" text="Segurança" />
                        <Label fx:id="pinStatusLabel" styleClass="card-footnote-success" text="PIN desativado" />
                        <PasswordField fx:id="currentPinField" prefHeight="42.0" promptText="PIN atual" />
                        <PasswordField fx:id="newPinField" prefHeight="42.0" promptText="Novo PIN" />
                        <PasswordField fx:id="confirmPinField" prefHeight="42.0" promptText="Confirmar novo PIN" />
                        <HBox spacing="12.0">
                           <children>
                              <Button fx:id="savePinButton" mnemonicParsing="false" onAction="#handleSavePin" prefWidth="170.0" styleClass="primary-button" text="Salvar PIN" />
                              <Button fx:id="removePinButton" mnemonicParsing="false" onAction="#handleRemovePin" prefWidth="170.0" styleClass="secondary-button" text="Remover PIN" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox maxWidth="1.7976931348623157E308" prefWidth="430.0" spacing="14.0" styleClass="dashboard-panel" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="panel-title" text="Sobre" />
                        <Label styleClass="card-label" text="Hyperion" />
                        <Label maxWidth="1.7976931348623157E308" styleClass="text-muted-left" text="Sistema local de gestão para pequenos empreendedores." wrapText="true" />
                        <Label styleClass="card-label" text="Créditos" />
                        <Label maxWidth="1.7976931348623157E308" styleClass="text-muted-left" text="Hyperion © 2026 Ryan dos Santos | @ryanoviski" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox maxWidth="1.7976931348623157E308" spacing="18.0" styleClass="dashboard-panel">
               <children>
                  <Label styleClass="panel-title" text="Dados locais" />
                  <Label styleClass="card-label" text="Banco de dados" />
                  <Label fx:id="databasePathLabel" maxWidth="1.7976931348623157E308" styleClass="text-muted-left" text="" wrapText="true" />
                  <Label styleClass="card-label" text="Pasta de backups" />
                  <Label fx:id="backupPathLabel" maxWidth="1.7976931348623157E308" styleClass="text-muted-left" text="" wrapText="true" />
               </children>
            </VBox>
            <VBox maxWidth="1.7976931348623157E308" spacing="18.0" styleClass="dashboard-panel">
               <children>
                  <Label styleClass="panel-title" text="Backup manual" />
                  <Label maxWidth="1.7976931348623157E308" styleClass="text-muted-left" text="Crie uma cópia do banco de dados local antes de grandes alterações ou ao fim do expediente." wrapText="true" />
                  <Button fx:id="createBackupButton" mnemonicParsing="false" onAction="#handleCreateBackup" prefWidth="220.0" styleClass="primary-button" text="Criar backup agora" />
                  <Label fx:id="messageLabel" maxWidth="1.7976931348623157E308" styleClass="text-muted-left" text="" wrapText="true" />
               </children>
            </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
