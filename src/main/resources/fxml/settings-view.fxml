<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.SettingsController">
   <center>
      <VBox spacing="22.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="page-title" text="Configurações" />
                  <Label styleClass="page-subtitle" text="Gerencie dados locais e backups do Hyperion." />
               </children>
            </VBox>
            <VBox prefWidth="720.0" spacing="18.0" styleClass="dashboard-panel">
               <children>
                  <Label styleClass="panel-title" text="Dados locais" />
                  <Label styleClass="card-label" text="Banco de dados" />
                  <Label fx:id="databasePathLabel" prefWidth="640.0" styleClass="text-muted-left" text="" wrapText="true" />
                  <Label styleClass="card-label" text="Pasta de backups" />
                  <Label fx:id="backupPathLabel" prefWidth="640.0" styleClass="text-muted-left" text="" wrapText="true" />
               </children>
            </VBox>
            <VBox prefWidth="720.0" spacing="18.0" styleClass="dashboard-panel">
               <children>
                  <Label styleClass="panel-title" text="Backup manual" />
                  <Label prefWidth="640.0" styleClass="text-muted-left" text="Crie uma cópia do banco de dados local antes de grandes alterações ou ao fim do expediente." wrapText="true" />
                  <Button fx:id="createBackupButton" mnemonicParsing="false" onAction="#handleCreateBackup" prefWidth="220.0" styleClass="primary-button" text="Criar backup agora" />
                  <Label fx:id="messageLabel" prefWidth="640.0" styleClass="text-muted-left" text="" wrapText="true" />
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
