<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.CreditController">
   <center>
      <VBox spacing="22.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="page-title" text="Crediário" />
                        <Label styleClass="page-subtitle" text="Acompanhe parcelas em aberto, vencidas e pagas." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" prefWidth="120.0" styleClass="secondary-button" text="Atualizar" />
               </children>
            </HBox>
            <HBox spacing="20.0">
               <children>
                  <VBox prefHeight="140.0" prefWidth="250.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Total em aberto" />
                        <Label fx:id="openAmountLabel" styleClass="card-value" text="R$ 0,00" />
                        <Label styleClass="card-footnote" text="Parcelas não pagas" />
                     </children>
                  </VBox>
                  <VBox prefHeight="140.0" prefWidth="220.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Vencidas" />
                        <Label fx:id="overdueCountLabel" styleClass="card-value" text="0" />
                        <Label styleClass="card-footnote-warning" text="Precisam de atenção" />
                     </children>
                  </VBox>
                  <VBox prefHeight="140.0" prefWidth="240.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Vencendo" />
                        <Label fx:id="dueSoonCountLabel" styleClass="card-value" text="0" />
                        <Label styleClass="card-footnote" text="Hoje ou próximos 3 dias" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox spacing="16.0" styleClass="dashboard-panel">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="panel-title" text="Parcelas em aberto" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="markPaidButton" mnemonicParsing="false" onAction="#handleMarkAsPaid" prefWidth="180.0" styleClass="primary-button" text="Marcar como paga" />
                     </children>
                  </HBox>
                  <TableView fx:id="openInstallmentsTable" prefHeight="260.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="openCustomerColumn" prefWidth="240.0" text="Cliente" />
                        <TableColumn fx:id="openInstallmentColumn" prefWidth="110.0" text="Parcela" />
                        <TableColumn fx:id="openDueDateColumn" prefWidth="130.0" text="Vencimento" />
                        <TableColumn fx:id="openAmountColumn" prefWidth="140.0" text="Valor" />
                        <TableColumn fx:id="openStatusColumn" prefWidth="140.0" text="Status" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
            <VBox spacing="16.0" styleClass="dashboard-panel">
               <children>
                  <Label styleClass="panel-title" text="Pagas recentemente" />
                  <TableView fx:id="paidInstallmentsTable" prefHeight="180.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="paidCustomerColumn" prefWidth="260.0" text="Cliente" />
                        <TableColumn fx:id="paidInstallmentColumn" prefWidth="120.0" text="Parcela" />
                        <TableColumn fx:id="paidDueDateColumn" prefWidth="140.0" text="Vencimento" />
                        <TableColumn fx:id="paidAmountColumn" prefWidth="150.0" text="Valor" />
                     </columns>
                  </TableView>
                  <Label fx:id="messageLabel" styleClass="text-muted-left" text="" />
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
