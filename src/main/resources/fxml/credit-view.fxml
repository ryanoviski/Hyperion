<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.CreditController">
   <center>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="16.0" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="28.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="page-title" text="Crediário" />
                        <Label styleClass="page-subtitle" text="Acompanhe e gerencie parcelas em aberto, vencidas e pagas." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" prefHeight="42.0" prefWidth="120.0" styleClass="secondary-button" text="Atualizar" />
               </children>
            </HBox>

            <HBox spacing="14.0">
               <children>
                  <VBox maxWidth="1.7976931348623157E308" prefHeight="110.0" prefWidth="190.0" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="card-label" text="Total em aberto" />
                        <Label fx:id="openAmountLabel" styleClass="card-value" text="R$ 0,00" />
                        <Label fx:id="openCountLabel" styleClass="card-footnote" text="0 parcelas não pagas" />
                     </children>
                  </VBox>
                  <VBox maxWidth="1.7976931348623157E308" prefHeight="110.0" prefWidth="170.0" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="card-label" text="Vencidas" />
                        <Label fx:id="overdueCountLabel" styleClass="card-value" text="0" />
                        <Label styleClass="card-footnote-warning" text="Precisam de atenção" />
                     </children>
                  </VBox>
                  <VBox maxWidth="1.7976931348623157E308" prefHeight="110.0" prefWidth="180.0" styleClass="dashboard-card" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="card-label" text="Vencendo" />
                        <Label fx:id="dueSoonCountLabel" styleClass="card-value" text="0" />
                        <Label styleClass="card-footnote" text="Hoje ou próximos 3 dias" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="16.0" styleClass="dashboard-panel" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="searchField" prefHeight="42.0" prefWidth="300.0" promptText="Buscar por cliente" HBox.hgrow="ALWAYS" />
                        <ChoiceBox fx:id="statusFilterChoiceBox" prefHeight="42.0" prefWidth="180.0" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="markPaidButton" mnemonicParsing="false" onAction="#handleMarkSelectedAsPaid" prefHeight="42.0" prefWidth="230.0" styleClass="primary-button" text="Marcar selecionadas como pagas" />
                        <Button mnemonicParsing="false" onAction="#handleRefresh" prefHeight="42.0" prefWidth="120.0" styleClass="secondary-button" text="Atualizar" />
                     </children>
                  </HBox>

                  <TableView fx:id="installmentsTable" prefHeight="390.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="customerColumn" prefWidth="230.0" styleClass="left-aligned-column" text="Cliente" />
                        <TableColumn fx:id="installmentColumn" prefWidth="110.0" text="Parcela" />
                        <TableColumn fx:id="dueDateColumn" prefWidth="140.0" text="Vencimento" />
                        <TableColumn fx:id="amountColumn" prefWidth="140.0" text="Valor" />
                        <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Status" />
                        <TableColumn fx:id="actionsColumn" prefWidth="180.0" text="Ações" />
                     </columns>
                  </TableView>

                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="messageLabel" styleClass="text-muted-left" text="" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="tableSummaryLabel" styleClass="text-muted-left" text="0 parcela(s)" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
