<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.ReportController">
   <center>
      <VBox spacing="22.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="page-title" text="Relatórios" />
                        <Label styleClass="page-subtitle" text="Acompanhe vendas, pagamentos e produtos mais vendidos." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" prefWidth="120.0" styleClass="secondary-button" text="Atualizar" />
               </children>
            </HBox>
            <HBox spacing="20.0">
               <children>
                  <VBox prefHeight="140.0" prefWidth="250.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Total vendido" />
                        <Label fx:id="totalSalesLabel" styleClass="card-value" text="R$ 0,00" />
                        <Label styleClass="card-footnote" text="Todas as vendas" />
                     </children>
                  </VBox>
                  <VBox prefHeight="140.0" prefWidth="220.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Quantidade de vendas" />
                        <Label fx:id="salesCountLabel" styleClass="card-value" text="0" />
                        <Label styleClass="card-footnote" text="Pedidos finalizados" />
                     </children>
                  </VBox>
                  <VBox prefHeight="140.0" prefWidth="240.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Ticket médio" />
                        <Label fx:id="averageTicketLabel" styleClass="card-value" text="R$ 0,00" />
                        <Label styleClass="card-footnote" text="Média por venda" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="20.0">
               <children>
                  <VBox spacing="16.0" styleClass="dashboard-panel" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="panel-title" text="Vendas por pagamento" />
                        <TableView fx:id="paymentMethodsTable" prefHeight="360.0" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="paymentMethodColumn" prefWidth="180.0" text="Pagamento" />
                              <TableColumn fx:id="paymentSalesCountColumn" prefWidth="120.0" text="Vendas" />
                              <TableColumn fx:id="paymentTotalColumn" prefWidth="160.0" text="Total" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
                  <VBox spacing="16.0" styleClass="dashboard-panel" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="panel-title" text="Produtos mais vendidos" />
                        <TableView fx:id="topProductsTable" prefHeight="360.0" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="productNameColumn" prefWidth="240.0" text="Produto" />
                              <TableColumn fx:id="productQuantityColumn" prefWidth="120.0" text="Qtd." />
                              <TableColumn fx:id="productTotalColumn" prefWidth="150.0" text="Total" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Label fx:id="messageLabel" styleClass="text-muted-left" text="" />
         </children>
      </VBox>
   </center>
</BorderPane>
