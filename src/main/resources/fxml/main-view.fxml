<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.MainController">
   <left>
      <VBox fx:id="sidebar" maxWidth="240.0" minWidth="240.0" prefWidth="240.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="sidebar-title" text="Hyperion" />
            <Label styleClass="sidebar-subtitle" text="Gestao local" />
            <Button fx:id="dashboardButton" mnemonicParsing="false" onAction="#handleDashboard" styleClass="sidebar-button-active" text="Dashboard" />
            <Button fx:id="customersButton" mnemonicParsing="false" onAction="#handleCustomers" styleClass="sidebar-button" text="Clientes" />
            <Button fx:id="productsButton" mnemonicParsing="false" onAction="#handleProducts" styleClass="sidebar-button" text="Produtos" />
            <Button fx:id="stockButton" mnemonicParsing="false" onAction="#handleStock" styleClass="sidebar-button" text="Estoque" />
            <Button fx:id="salesButton" mnemonicParsing="false" onAction="#handleSales" styleClass="sidebar-button" text="Vendas" />
            <Button fx:id="financeButton" mnemonicParsing="false" onAction="#handleUnavailableSection" styleClass="sidebar-button" text="Financeiro" />
            <Button fx:id="reportsButton" mnemonicParsing="false" onAction="#handleUnavailableSection" styleClass="sidebar-button" text="Relatorios" />
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="settingsButton" mnemonicParsing="false" onAction="#handleUnavailableSection" styleClass="sidebar-button" text="Configuracoes" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentContainer" styleClass="content-area" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
