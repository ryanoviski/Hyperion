<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.FinanceController">
   <center>
      <VBox spacing="22.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="page-title" text="Financeiro" />
                  <Label styleClass="page-subtitle" text="Acompanhe vendas, despesas e saldo do negócio." />
               </children>
            </VBox>
            <HBox spacing="20.0">
               <children>
                  <VBox prefHeight="140.0" prefWidth="210.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Entradas" />
                        <Label fx:id="totalIncomeLabel" styleClass="card-value" text="R$ 0,00" />
                        <Label styleClass="card-footnote-success" text="Vendas registradas" />
                     </children>
                  </VBox>
                  <VBox prefHeight="140.0" prefWidth="210.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Despesas" />
                        <Label fx:id="totalExpensesLabel" styleClass="card-value" text="R$ 0,00" />
                        <Label styleClass="card-footnote-warning" text="Saídas manuais" />
                     </children>
                  </VBox>
                  <VBox prefHeight="140.0" prefWidth="210.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Saldo atual" />
                        <Label fx:id="currentBalanceLabel" styleClass="card-value" text="R$ 0,00" />
                        <Label styleClass="card-footnote" text="Entradas - despesas" />
                     </children>
                  </VBox>
                  <VBox prefHeight="140.0" prefWidth="210.0" styleClass="dashboard-card">
                     <children>
                        <Label styleClass="card-label" text="Lucro do mês" />
                        <Label fx:id="monthlyProfitLabel" styleClass="card-value" text="R$ 0,00" />
                        <Label styleClass="card-footnote" text="Mês atual" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="20.0">
               <children>
                  <VBox prefWidth="340.0" spacing="14.0" styleClass="dashboard-panel">
                     <children>
                        <Label styleClass="panel-title" text="Nova despesa" />
                        <TextField fx:id="descriptionField" prefHeight="42.0" promptText="Descrição" />
                        <TextField fx:id="categoryField" prefHeight="42.0" promptText="Categoria" />
                        <TextField fx:id="amountField" prefHeight="42.0" promptText="Valor em R$" />
                        <Button fx:id="addExpenseButton" mnemonicParsing="false" onAction="#handleAddExpense" prefWidth="300.0" styleClass="primary-button" text="Registrar despesa" />
                        <Label fx:id="messageLabel" styleClass="text-muted-left" text="" wrapText="true" />
                     </children>
                  </VBox>
                  <VBox spacing="16.0" styleClass="dashboard-panel" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="panel-title" text="Despesas recentes" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" prefWidth="120.0" styleClass="secondary-button" text="Atualizar" />
                              <Button fx:id="removeExpenseButton" mnemonicParsing="false" onAction="#handleRemoveExpense" prefWidth="130.0" styleClass="secondary-button" text="Remover" />
                           </children>
                        </HBox>
                        <TableView fx:id="expensesTable" prefHeight="360.0" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Data" />
                              <TableColumn fx:id="descriptionColumn" prefWidth="260.0" text="Descrição" />
                              <TableColumn fx:id="categoryColumn" prefWidth="150.0" text="Categoria" />
                              <TableColumn fx:id="amountColumn" prefWidth="140.0" text="Valor" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
