<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.ProductController">
   <center>
      <VBox spacing="22.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="page-title" text="Produtos" />
                        <Label styleClass="page-subtitle" text="Cadastre produtos, preços e quantidade em estoque." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="newProductButton" mnemonicParsing="false" onAction="#handleNewProduct" prefWidth="160.0" styleClass="primary-button" text="Novo produto" />
               </children>
            </HBox>
            <VBox spacing="16.0" styleClass="dashboard-panel">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <TextField fx:id="searchField" onAction="#handleSearch" prefHeight="42.0" promptText="Buscar por nome, categoria, código ou fornecedor" HBox.hgrow="ALWAYS" />
                        <Button fx:id="searchButton" mnemonicParsing="false" onAction="#handleSearch" prefWidth="110.0" styleClass="secondary-button" text="Buscar" />
                        <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" prefWidth="120.0" styleClass="secondary-button" text="Atualizar" />
                     </children>
                  </HBox>
                  <TableView fx:id="productsTable" prefHeight="430.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="nameColumn" prefWidth="220.0" text="Nome" />
                        <TableColumn fx:id="categoryColumn" prefWidth="150.0" text="Categoria" />
                        <TableColumn fx:id="priceColumn" prefWidth="120.0" text="Preço" />
                        <TableColumn fx:id="costColumn" prefWidth="120.0" text="Custo" />
                        <TableColumn fx:id="stockColumn" prefWidth="100.0" text="Estoque" />
                        <TableColumn fx:id="barcodeColumn" prefWidth="150.0" text="Código" />
                        <TableColumn fx:id="supplierColumn" prefWidth="180.0" text="Fornecedor" />
                     </columns>
                  </TableView>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label fx:id="messageLabel" styleClass="text-muted-left" text="" HBox.hgrow="ALWAYS" />
                        <Button fx:id="editProductButton" mnemonicParsing="false" onAction="#handleEditProduct" prefWidth="120.0" styleClass="secondary-button" text="Editar" />
                        <Button fx:id="deactivateProductButton" mnemonicParsing="false" onAction="#handleDeactivateProduct" prefWidth="130.0" styleClass="secondary-button" text="Desativar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
