<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="760.0" prefWidth="1200.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hyperion.controller.CustomerController">
   <center>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="22.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="page-title" text="Clientes" />
                        <Label styleClass="page-subtitle" text="Cadastre, encontre e mantenha sua base de clientes." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="newCustomerButton" mnemonicParsing="false" onAction="#handleNewCustomer" prefWidth="160.0" styleClass="primary-button" text="Novo cliente" />
               </children>
            </HBox>
            <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="16.0" styleClass="dashboard-panel" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <TextField fx:id="searchField" onAction="#handleSearch" prefHeight="42.0" promptText="Buscar por nome, CPF/CNPJ, telefone ou email" HBox.hgrow="ALWAYS" />
                        <ChoiceBox fx:id="statusFilterChoiceBox" prefHeight="42.0" prefWidth="120.0" />
                        <Button fx:id="searchButton" mnemonicParsing="false" onAction="#handleSearch" prefWidth="110.0" styleClass="secondary-button" text="Buscar" />
                        <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" prefWidth="120.0" styleClass="secondary-button" text="Atualizar" />
                     </children>
                  </HBox>
                  <TableView fx:id="customersTable" prefHeight="430.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="nameColumn" prefWidth="240.0" text="Nome" />
                        <TableColumn fx:id="documentColumn" prefWidth="160.0" text="Documento" />
                        <TableColumn fx:id="phoneColumn" prefWidth="150.0" text="Telefone" />
                        <TableColumn fx:id="emailColumn" prefWidth="260.0" text="Email" />
                        <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Status" />
                        <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Ações" />
                     </columns>
                  </TableView>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label fx:id="messageLabel" styleClass="text-muted-left" text="" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
